/*
 * config.h -- generated by CMake from cmake/config.h.in.
 *
 * Stands in for the autotools-generated src/config.h, mirroring the checks in
 * configure.ac. Included (with a tab) by src/def.h, so every translation unit
 * that pulls in def.h sees these defines.
 */
#ifndef MG_CONFIG_H
#define MG_CONFIG_H

/* Package metadata (configure.ac: AC_INIT([Mg],[3.8-pre],…,[mg])). */
#define PACKAGE           "mg"
#define PACKAGE_NAME      "Mg"
#define PACKAGE_TARNAME   "mg"
#define PACKAGE_VERSION   "@MG_VERSION@"
#define PACKAGE_STRING    "Mg @MG_VERSION@"
#define PACKAGE_BUGREPORT "https://github.com/troglobit/mg/issues"
#define PACKAGE_URL       ""
#define VERSION           "@MG_VERSION@"

/* System headers (configure.ac: AC_CHECK_HEADERS). */
#cmakedefine HAVE_PTY_H 1
#cmakedefine HAVE_UTMP_H 1
#cmakedefine HAVE_NCURSES_CURSES_H 1
#cmakedefine HAVE_TERM_H 1

/* Replaceable libc functions (configure.ac: AC_REPLACE_FUNCS). When a HAVE_*
   is undefined, def.h declares the prototype and lib/<fn>.c is compiled in. */
#cmakedefine HAVE_FPARSELN 1
#cmakedefine HAVE_FUTIMENS 1
#cmakedefine HAVE_LOGIN_TTY 1
#cmakedefine HAVE_OPENPTY 1
#cmakedefine HAVE_REALLOCARRAY 1
#cmakedefine HAVE_STRLCAT 1
#cmakedefine HAVE_STRLCPY 1
#cmakedefine HAVE_STRTONUM 1

/* Optional features (configure.ac: AC_ARG_ENABLE; all default-on). */
#cmakedefine ENABLE_AUTOEXEC 1
#cmakedefine ENABLE_CMODE 1
#cmakedefine ENABLE_COMPILE_GREP 1
#cmakedefine CSCOPE 1
#cmakedefine ENABLE_CTAGS 1
#cmakedefine ENABLE_DIRED 1
#cmakedefine REGEX 1
#cmakedefine TOGGLENL 1

/* Set only when no termcap/curses library is available. */
#cmakedefine WITHOUT_CURSES 1

/* Fallback init file run when ~/.mg is missing (configure --with-startup). */
#define STARTUPFILE "@MG_STARTUPFILE@"

#endif /* MG_CONFIG_H */
