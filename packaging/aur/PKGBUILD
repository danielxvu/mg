# Maintainer: Daniel Vu <duongxvu@gmail.com>
#
# neomg -- a fork of mg (OpenBSD micro-emacs) refactored to C++23 with a native
# Magit (git porcelain). Installs as `neomg`, so it coexists with the distro's
# stock `mg` package. Builds via CMake (the cpp-linux preset, ENABLE_NATIVE_MAGIT
# =ON) using the distro clang -- the same toolchain the Arch CI image uses.
#
# `neomg` is the fork's stable integration branch: it tracks the tip of the
# feature stack and always contains the full fork (native magit, the CLI write
# path, log extras, the neomg branding). `master` deliberately mirrors upstream
# mg, so do NOT build from it -- it has none of the fork's features.
_branch=neomg

pkgname=neomg-git
_pkgname=neomg
pkgver=0
pkgrel=1
pkgdesc="micro-emacs (mg) fork with native Magit, C++23 -- installs as neomg"
arch=('x86_64' 'aarch64')
url="https://github.com/danielxvu/mg"
license=('custom:public-domain')   # mg is public domain (OpenBSD lineage)
depends=('libgit2' 'libutf8proc' 'ncurses')
makedepends=('git' 'cmake' 'ninja' 'clang' 'llvm' 'pkgconf' 'zig')
# zig (extra/zig) 0.16+ is required: the syntax/ Zig library is compiled by
# CMake via `zig build-lib` and linked into mg_magit.  Arch ships 0.16.0.
provides=('neomg')
conflicts=('neomg')
options=('!lto')   # C++23 named modules + LTO can mis-link on some clang builds
source=("${_pkgname}::git+${url}.git#branch=${_branch}")
sha256sums=('SKIP')

pkgver() {
	cd "${srcdir}/${_pkgname}"
	printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
	cd "${srcdir}/${_pkgname}"
	# clang ships clang-scan-deps (CMake's C++20-module dependency scanner);
	# the cpp-linux preset uses clang/clang++ from PATH and sets
	# ENABLE_NATIVE_MAGIT=ON. Build dir is ./build (the preset's binaryDir).
	cmake --preset cpp-linux
	cmake --build --preset cpp-linux
}

check() {
	cd "${srcdir}/${_pkgname}"
	# A few tests exercise the real commit path (git_signature_default), which
	# needs a git identity. Provide one in an isolated config so makepkg never
	# touches the builder's ~/.gitconfig.
	export GIT_CONFIG_GLOBAL="${srcdir}/gitconfig"
	git config -f "${GIT_CONFIG_GLOBAL}" user.email "build@neomg.test"
	git config -f "${GIT_CONFIG_GLOBAL}" user.name  "neomg build"
	ctest --preset cpp-linux
}

package() {
	cd "${srcdir}/${_pkgname}"
	# Lays down ${pkgdir}/usr/bin/neomg and ${pkgdir}/usr/share/man/man1/neomg.1.
	DESTDIR="${pkgdir}" cmake --install build --prefix /usr

	# neomg's own code is public domain; LICENSING.md documents that plus the
	# linked deps (libgit2 GPLv2-w/-linking-exception, utf8proc, ncurses --
	# separate packages here). Ship it for makepkg's license=('custom') rule.
	install -Dm644 LICENSING.md "${pkgdir}/usr/share/licenses/${pkgname}/LICENSING.md"
}
