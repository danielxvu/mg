# Build + test mg (C++23 modules + native-magit, ENABLE_NATIVE_MAGIT=ON) on
# Arch Linux -- the primary Linux target. Verifies the modules toolchain, the
# inotify fswatch backend (compiled here for the first time), and the async
# stack (status monitor + blame worker) end to end.
#
#   docker build -f docker/Dockerfile.arch -t mg-arch .
#
# Native build on an Arch host (same toolchain, no container):
#   sudo pacman -S --needed clang llvm cmake ninja git libgit2 libutf8proc pkgconf
#   cmake --preset cpp-linux && cmake --build --preset cpp-linux
#   ctest --preset cpp-linux            # full suite (incl. recursive inotify)
#   sudo cmake --install build --prefix /usr/local
#
# The build + ctest run during `docker build`, so a failure fails the image.
#
# Note: the official archlinux image is x86_64-only. On a native x86_64 Arch
# host (the intended target) this just works. To build it on an arm64 host
# (e.g. an Apple-silicon Mac) under emulation, pacman 7's download sandbox
# fails to set up seccomp -- add `--build-arg` plumbing or append
# `--disable-sandbox` to the pacman line; native x86_64 needs nothing. The code
# itself is arch-independent (verified on arm64-native Arch + Alpine too).
FROM archlinux:latest

# clang ships clang-scan-deps (CMake's C++20 module dependency scanner);
# libgit2 provides its pkg-config .pc that src/magit/CMakeLists.txt consumes.
RUN pacman -Syu --noconfirm \
        base-devel clang llvm cmake ninja git libgit2 libutf8proc pkgconf \
    && pacman -Scc --noconfirm

WORKDIR /src
COPY . .

# Which preset to build: cpp-linux (default) or cpp-linux-tsan (native-Linux
# ThreadSanitizer gate -- no Apple-runtime dance needed off macOS). CI builds
# both. ENV carries it to CMD for `docker run`.
ARG PRESET=cpp-linux
ENV MG_PRESET=${PRESET}

# The preset uses the distro clang/clang++ in PATH (CMake auto-detects
# clang-scan-deps next to it) -- no MacPorts paths (those live only in the macOS
# `cpp` preset).
RUN cmake --preset "${PRESET}" \
    && cmake --build --preset "${PRESET}"

# A few tests exercise the production commit path, which requires a git
# identity (git_signature_default). A dev machine has one in ~/.gitconfig; a
# fresh container does not -- provide one so the suite runs as it does locally.
RUN git config --global user.email "build@mg.test" \
    && git config --global user.name "mg build"

RUN ctest --preset "${MG_PRESET}"

CMD ctest --preset "${MG_PRESET}"
